EAT_DEMO_MODE=false
WEB_PORT=3000
# Application (client) ID of your single multi-tenant Entra app (see README section 1).
EAT_CLIENT_ID=
# Optional: override the Microsoft login library URL (default tries a vendored
# ./msal-browser.min.js first, then the Microsoft CDN). Leave empty normally.
EAT_MSAL_SRC=
# Optional: delegated scopes requested at sign-in (comma/space separated).
EAT_EXO_SCOPES=https://outlook.office365.com/.default
# Optional: Microsoft Graph delegated scopes for the Licenses + Teams categories
# (subscribedSkus + per-user assignments + teams/channels/members). Requires the
# matching API permissions + admin consent (see README section 1).
# Add AuditLog.Read.All to enable the "Last sign-in" column of the
# Unlicensed users section (then re-consent + reconnect).
EAT_GRAPH_SCOPES=User.Read.All Organization.Read.All Group.Read.All Team.ReadBasic.All Channel.ReadBasic.All TeamMember.Read.All ChannelMember.Read.All TeamsAppInstallation.ReadForTeam TeamsTab.Read.All Reports.Read.All ChannelMessage.Read.All Sites.Read.All SharePointTenantSettings.Read.All
