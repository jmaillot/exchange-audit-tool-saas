EAT_DEMO_MODE=false
WEB_PORT=3000
# Application (client) ID of your single multi-tenant Entra app (see README section 1).
EAT_CLIENT_ID=
# Optional: override the Microsoft login library URL (default tries a vendored
# ./msal-browser.min.js first, then the Microsoft CDN). Leave empty normally.
EAT_MSAL_SRC=
# Optional: delegated scopes requested at sign-in (comma/space separated).
EAT_EXO_SCOPES=https://outlook.office365.com/.default
